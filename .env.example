# Copy this file to .env and fill in your values
# .env is gitignored and never committed

# Required: Anthropic API key for AI photo scoring
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Full path to the adb binary (defaults to "adb" if it's already in PATH)
# Example: ADB_PATH=/home/user/Android/Sdk/platform-tools/adb
ADB_PATH=adb
